# Conexão da aplicação — role NÃO-owner, NOBYPASSRLS (T-057a).
# Nunca aponte para service_role/owner aqui: RLS seria ignorado.
DATABASE_URL=postgresql+psycopg2://estetica_app:CHANGEME@localhost:5432/estetica

# Conexão separada para Alembic — pode ser o owner.
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://postgres:CHANGEME@localhost:5432/estetica

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

DEFAULT_TIMEZONE=America/Sao_Paulo
ENV=development

# --- Somente para desenvolvimento local sem Supabase real ---
# Ver app/core/security.py: só tem efeito quando ENV=development.
DEV_AUTH_SECRET=CHANGEME

# --- Opcionais: rodam tests/test_supabase_auth_integration.py (B-03) ---
# Credenciais de um usuário REAL do Supabase Auth deste projeto, para
# provar o caminho JWKS de _decode() com um JWT genuíno, não um mock.
# Sem elas o teste pula (skip), nunca falha. NUNCA commitar valores reais.
# SUPABASE_TEST_EMAIL=
# SUPABASE_TEST_PASSWORD=
# SUPABASE_TEST_ANON_KEY=
